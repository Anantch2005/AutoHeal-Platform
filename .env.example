# Example .env file for Autoheal Platform
# Update this file with your own values and rename it to .env before running the application.
# =========================================================
# Jenkins
# =========================================================

JENKINS_URL=http://host.docker.internal:8080
JENKINS_USERNAME=admin
JENKINS_API_TOKEN=replace-me

# Jenkins webhook secret
WEBHOOK_SECRET=replace-me

# =========================================================
# PostgreSQL
# =========================================================

POSTGRES_DB=autoheal
POSTGRES_USER=autoheal
POSTGRES_PASSWORD=replace-me

DATABASE_URL=postgresql+psycopg2://autoheal:replace-me@postgres:5432/autoheal

# =========================================================
# AI / Ollama
# =========================================================

AI_ENABLED=true
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
AI_MAX_LOG_CHARS=12000

# =========================================================
# OpenTelemetry
# =========================================================

OTEL_ENDPOINT=http://otel-collector:4318

# =========================================================
# Alertmanager
# =========================================================

ALERTMANAGER_SECRET=replace-me