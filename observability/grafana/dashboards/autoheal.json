        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (category) (rate(autoheal_ai_classifications_total[5m]))",
          "legendFormat": "{{category}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Policy Denials by Category",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (category) (rate(autoheal_policy_denials_total[5m]))",
          "legendFormat": "{{category}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Remediation Attempts by Category",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (category) (rate(autoheal_remediation_attempts_total[5m]))",
          "legendFormat": "{{category}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Incident Processing Duration (p95)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(autoheal_processing_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "table",
      "title": "Recent AutoHeal Incidents",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "postgres",
        "uid": "autoheal-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT\n  i.created_at AS \"time\",\n  i.incident_id,\n  i.job_name,\n  i.build_number,\n  i.status,\n  i.failure_category AS category,\n  i.classifier_source AS source,\n  i.confidence,\n  COALESCE(ra.action, 'NONE') AS remediation_action,\n  ra.success AS remediation_success,\n  ra.retry_build_number,\n  ra.verification_result\nFROM incidents i\nLEFT JOIN LATERAL (\n  SELECT\n    action,\n    success,\n    retry_build_number,\n    verification_result\n  FROM remediation_attempts\n  WHERE remediation_attempts.incident_id = i.id\n  ORDER BY remediation_attempts.id DESC\n  LIMIT 1\n) ra ON TRUE\nWHERE $__timeFilter(i.created_at)\nORDER BY i.created_at DESC\nLIMIT 25;"
        }
      ]
    },
    {
      "type": "table",
      "title": "AI Output — Diagnosis & Reasoning",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "datasource": {
        "type": "postgres",
        "uid": "autoheal-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT\n  i.created_at AS \"time\",\n  i.incident_id,\n  i.job_name,\n  i.build_number,\n  i.failure_category AS category,\n  i.classifier_source AS source,\n  ROUND(i.confidence::numeric, 3) AS classifier_confidence,\n  ROUND(i.ai_confidence::numeric, 3) AS ai_confidence,\n  i.ai_root_cause,\n  i.ai_reasoning\nFROM incidents i\nWHERE $__timeFilter(i.created_at)\n  AND i.ai_root_cause IS NOT NULL\nORDER BY i.created_at DESC\nLIMIT 25;"
        }
      ]
    },
    {
      "type": "table",
      "title": "AutoHeal Audit Trail",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 49
      },
      "datasource": {
        "type": "postgres",
        "uid": "autoheal-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT\n  a.created_at AS \"time\",\n  i.incident_id,\n  i.job_name,\n  i.build_number,\n  a.event_type,\n  a.message\nFROM audit_events a\nJOIN incidents i\n  ON i.id = a.incident_id\nWHERE $__timeFilter(a.created_at)\nORDER BY a.created_at DESC\nLIMIT 30;"
        }
      ]
    }
  ],
  "refresh": "15s",
